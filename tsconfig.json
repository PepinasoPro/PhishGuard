{
  "compilerOptions": {
    "target": "es2022",
    "lib": [
      "es2022"
    ],
    "jsx": "react-native",
    "module": "ESNext",
    "moduleResolution": "bundler", // <--- Cambia "node16" por "bundler"
    "allowSyntheticDefaultImports": true,
    "noEmit": true,
    "strict": true,
    "skipLibCheck": true
  },
  "exclude": [
    "node_modules",
    "babel.config.js",
    "metro.config.js",
    "jest.config.js"
  ],
  "extends": "expo/tsconfig.base"
}